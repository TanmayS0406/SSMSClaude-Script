<UserControl x:Class="SsmsChatExtension.UI.ChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:ui="clr-namespace:SsmsChatExtension.UI"
             MinWidth="260" MinHeight="200"
             Background="{DynamicResource ChatBackground}"
             Foreground="{DynamicResource ChatForeground}">

    <!--
        Colours come from ChatTheme.Apply (ChatBackground, ChatForeground, ChatAccent, ...), which writes them into
        these resources for the theme picked with the palette button. Icons are Segoe Fluent Icons glyphs
        (Windows 11), falling back to Segoe MDL2 Assets (Windows 10 / Server).
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ui:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Combo box items: an empty value means "use the default". -->
        <DataTemplate x:Key="OptionalValueTemplate">
            <TextBlock x:Name="Value" Text="{Binding}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="">
                    <Setter TargetName="Value" Property="Text" Value="(default)" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ChatMutedForeground}" />
        </Style>

        <!-- The Claude mark (a sparkle) used in the header, the empty chat and Claude's replies. -->
        <Style x:Key="BrandMark" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="Text" Value="&#x2726;" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource ChatAccent}" />
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ===== Slim scroll bar in theme colours (implicit, applies to every ScrollViewer here) ===== -->
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,2,0,2">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" CornerRadius="3" MinHeight="24" Background="{DynamicResource ChatBorder}" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ChatMutedForeground}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Radio buttons in Settings: themed circle, wrapping labels. -->
        <Style x:Key="ThemedRadio" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource ChatForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <DockPanel Background="Transparent" LastChildFill="True">
                            <Grid DockPanel.Dock="Left" Width="14" Height="14" Margin="0,1,7,0" VerticalAlignment="Top">
                                <Ellipse x:Name="Ring" StrokeThickness="1.5" Stroke="{DynamicResource ChatMutedForeground}"
                                         Fill="{DynamicResource ChatInputBackground}" />
                                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource ChatAccent}" Visibility="Collapsed" />
                            </Grid>
                            <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" Foreground="{TemplateBinding Foreground}" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ChatAccent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ChatAccent}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Secondary button: icon (ui:ButtonChrome.Icon) + text on a soft surface ===== -->
        <Style x:Key="ChatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ChatForeground}" />
            <Setter Property="Background" Value="{DynamicResource ChatSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChatBorder}" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6" BorderThickness="1" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                                <TextBlock x:Name="Icon" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0"
                                           Text="{TemplateBinding ui:ButtonChrome.Icon}" Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter x:Name="Content" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ui:ButtonChrome.Icon" Value="{x:Null}">
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Icon" Property="Margin" Value="0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ChatSurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ChatSurfacePressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Toolbar button: icon only, flat until hovered; ui:ButtonChrome.IsActive marks an open panel ===== -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ChatForeground}" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6" Background="Transparent" SnapsToDevicePixels="True">
                            <TextBlock x:Name="Icon" Style="{StaticResource Glyph}" FontSize="15" HorizontalAlignment="Center"
                                       Text="{TemplateBinding ui:ButtonChrome.Icon}" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ChatSurfaceHover}" />
                            </Trigger>
                            <Trigger Property="ui:ButtonChrome.IsActive" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ChatSurfacePressed}" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource ChatAccent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ChatSurfacePressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small icon button that turns red on hover (delete / remove). -->
        <Style x:Key="DangerIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource ChatMutedForeground}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ChatDanger}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Primary button (Send, Sign in, Save): accent fill ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ChatOnAccent}" />
            <Setter Property="Background" Value="{DynamicResource ChatAccent}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="Icon" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0"
                                           Text="{TemplateBinding ui:ButtonChrome.Icon}" Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter x:Name="Content" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  TextElement.FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ui:ButtonChrome.Icon" Value="{x:Null}">
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Icon" Property="Margin" Value="0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ChatAccentHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Footer link (Documentation, Website, Sponsor) ===== -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ChatMutedForeground}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="{Binding CommandParameter, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,5,0"
                                       Text="{TemplateBinding ui:ButtonChrome.Icon}" Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter x:Name="Content" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ChatAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Chip-style check box (Query context) ===== -->
        <Style x:Key="ChipToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ChatMutedForeground}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Chrome" CornerRadius="12" BorderThickness="1" Padding="8,3"
                                Background="Transparent" BorderBrush="{DynamicResource ChatBorder}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Icon" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,5,0"
                                           Text="{TemplateBinding ui:ButtonChrome.Icon}" Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ChatSurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ChatAccent}" />
                                <Setter Property="Foreground" Value="{DynamicResource ChatAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Settings text box ===== -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource ChatForeground}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ChatForeground}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource ChatAccent}" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" CornerRadius="6" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource ChatInputBackground}" BorderBrush="{DynamicResource ChatBorder}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ChatAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Message box inside the composer: no chrome of its own ===== -->
        <Style x:Key="ComposerText" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource ChatForeground}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ChatForeground}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource ChatAccent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Read-only, selectable message text ===== -->
        <Style x:Key="MessageText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ChatForeground}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ChatForeground}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource ChatAccent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Collapsible panel (history, appearance, settings) ===== -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ChatSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChatBorder}" />
        </Style>

        <!-- ===== Picker list (themes, accents): wrapping items, accent ring on the selected one ===== -->
        <Style x:Key="PickerList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,4,4" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="ToolTip" Value="{Binding DisplayName}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Ring" BorderThickness="2" Padding="2" CornerRadius="9"
                                            BorderBrush="Transparent" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ChatBorder}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ChatAccent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== One chat bubble ===== -->
        <DataTemplate x:Key="MessageTemplate">
            <Border x:Name="Bubble" Margin="0,5,32,5" Padding="12,8,12,10" CornerRadius="10"
                    HorizontalAlignment="Stretch" Background="{DynamicResource ChatAssistantBubble}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="RoleIcon" Style="{StaticResource BrandMark}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ChatMutedForeground}" />
                    </StackPanel>
                    <TextBox x:Name="Body" Text="{Binding Text, Mode=OneWay}" Style="{StaticResource MessageText}" />
                    <!-- Run status: the mark spins while Claude works ("Thinking… 4s"), then "Done in 12s" -->
                    <StackPanel x:Name="RunFooter" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="RunMark" Style="{StaticResource BrandMark}" FontSize="11" Margin="0,0,5,0"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="{Binding RunStatus}" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ChatMutedForeground}" />
                    </StackPanel>
                    <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                        <Button Content="Insert into query" Style="{StaticResource ChatButton}" Padding="7,3" FontSize="11"
                                ui:ButtonChrome.Icon="&#xE943;"
                                ToolTip="Insert the SQL from this reply into the active query window"
                                Command="{Binding DataContext.InsertCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Copy" Style="{StaticResource ChatButton}" Padding="7,3" FontSize="11"
                                ui:ButtonChrome.Icon="&#xE8C8;"
                                Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="Bubble" Property="Margin" Value="32,5,0,5" />
                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource ChatUserBubble}" />
                    <Setter TargetName="RoleIcon" Property="FontFamily" Value="{StaticResource IconFont}" />
                    <Setter TargetName="RoleIcon" Property="Text" Value="&#xE77B;" />
                    <Setter TargetName="RoleIcon" Property="Foreground" Value="{DynamicResource ChatMutedForeground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                    <Setter TargetName="Bubble" Property="Margin" Value="16,5,16,5" />
                    <Setter TargetName="Bubble" Property="Background" Value="Transparent" />
                    <Setter TargetName="RoleIcon" Property="FontFamily" Value="{StaticResource IconFont}" />
                    <Setter TargetName="RoleIcon" Property="Text" Value="&#xE946;" />
                    <Setter TargetName="RoleIcon" Property="Foreground" Value="{DynamicResource ChatMutedForeground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- Nothing to show until the first words arrive -->
                <DataTrigger Binding="{Binding Text}" Value="">
                    <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunState}" Value="Running">
                    <Setter TargetName="RunFooter" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="SpinMark">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RunMark"
                                                 Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:1.4" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="SpinMark" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding RunState}" Value="Done">
                    <Setter TargetName="RunFooter" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunState}" Value="Stopped">
                    <Setter TargetName="RunFooter" Property="Visibility" Value="Visible" />
                    <Setter TargetName="RunMark" Property="Foreground" Value="{DynamicResource ChatMutedForeground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RunState}" Value="Failed">
                    <Setter TargetName="RunFooter" Property="Visibility" Value="Visible" />
                    <Setter TargetName="RunMark" Property="Foreground" Value="{DynamicResource ChatMutedForeground}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" ui:ButtonChrome.Icon="&#xE932;" Command="{Binding ClearCommand}"
                            ToolTip="New chat (the current one stays in History)" />
                    <Button Style="{StaticResource IconButton}" ui:ButtonChrome.Icon="&#xE81C;" Command="{Binding ToggleHistoryCommand}"
                            ui:ButtonChrome.IsActive="{Binding IsHistoryOpen}" ToolTip="Chat history" />
                    <Button Style="{StaticResource IconButton}" ui:ButtonChrome.Icon="&#xEE94;" Command="{Binding DatabaseDiagramCommand}"
                            ToolTip="Database diagram: ER diagram of the active connection's databases, opened in your browser" />
                    <Button Style="{StaticResource IconButton}" ui:ButtonChrome.Icon="&#xE790;" Command="{Binding Appearance.ToggleCommand}"
                            ui:ButtonChrome.IsActive="{Binding Appearance.IsOpen}" ToolTip="Theme and accent colour" />
                    <Button Style="{StaticResource IconButton}" ui:ButtonChrome.Icon="&#xE713;" Command="{Binding Account.ToggleSettingsCommand}"
                            ui:ButtonChrome.IsActive="{Binding Account.IsSettingsOpen}" ToolTip="Settings" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BrandMark}" FontSize="18" Margin="2,0,8,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Claude Chat" FontWeight="SemiBold" />
                        <TextBlock FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ChatMutedForeground}"
                                   Text="{Binding ServiceName}" ToolTip="{Binding ServiceName}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Chat history -->
            <Border Style="{StaticResource Panel}" Padding="6"
                    Visibility="{Binding IsHistoryOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1" LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerIconButton}" Margin="4,0,0,0"
                                                ui:ButtonChrome.Icon="&#xE74D;" ToolTip="Delete this chat"
                                                Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource ChatButton}" Margin="0" Padding="8,4" HorizontalContentAlignment="Left"
                                                Background="Transparent" BorderBrush="Transparent" ui:ButtonChrome.Icon="&#xE8BD;"
                                                Command="{Binding DataContext.OpenConversationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" ToolTip="Open this chat">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DisplayDate}" FontSize="10" Foreground="{DynamicResource ChatMutedForeground}" />
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Margin="4" FontSize="11" Foreground="{DynamicResource ChatMutedForeground}" Text="No saved chats yet.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding History.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Appearance: theme and accent -->
            <Border Style="{StaticResource Panel}" DataContext="{Binding Appearance}"
                    Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="THEME" />
                    <ListBox Margin="0,6,0,0" Style="{StaticResource PickerList}"
                             ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="78" Margin="0,0,0,2">
                                    <Border Height="44" CornerRadius="6" BorderThickness="1" Padding="7,6"
                                            Background="{Binding PreviewBackground}" BorderBrush="{DynamicResource ChatBorder}">
                                        <StackPanel>
                                            <Border Height="4" Width="40" CornerRadius="2" HorizontalAlignment="Left"
                                                    Background="{Binding PreviewForeground}" Opacity="0.8" />
                                            <Border Height="4" Width="28" Margin="0,4,0,0" CornerRadius="2" HorizontalAlignment="Left"
                                                    Background="{Binding PreviewForeground}" Opacity="0.4" />
                                            <Border Height="8" Width="22" Margin="0,5,0,0" CornerRadius="3" HorizontalAlignment="Right"
                                                    Background="{Binding PreviewAccent}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Margin="0,4,0,0" FontSize="11" HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Margin="0,6,0,0" Style="{StaticResource SectionLabel}" Text="ACCENT" />
                    <ListBox Margin="0,6,0,0" Style="{StaticResource PickerList}"
                             ItemsSource="{Binding Accents}" SelectedItem="{Binding Accent}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="22" Height="22">
                                    <Ellipse Fill="{Binding PreviewBrush}" />
                                    <TextBlock x:Name="Auto" Style="{StaticResource Glyph}" FontSize="13" HorizontalAlignment="Center"
                                               Text="&#xE790;" Visibility="Collapsed" Foreground="{DynamicResource ChatMutedForeground}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsThemeDefault}" Value="True">
                                        <Setter TargetName="Auto" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ChatMutedForeground}"
                               Text="Changes apply right away. 'Follow SSMS' matches Tools > Theme in SSMS." />
                </StackPanel>
            </Border>

            <!-- Claude account -->
            <Border Margin="0,8,0,0" Padding="8,5" CornerRadius="8" Background="{DynamicResource ChatSurface}"
                    DataContext="{Binding Account}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Sign in" Margin="6,0,0,0" ui:ButtonChrome.Icon="&#xE8D7;"
                            ToolTip="Sign in with your Claude account (opens the Claude Code sign-in)"
                            Command="{Binding SignInCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Padding" Value="10,4" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button DockPanel.Dock="Right" Margin="4,0,0,0" ui:ButtonChrome.Icon="&#xF3B1;" ToolTip="Sign out"
                            Command="{Binding SignOutCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ui:ButtonChrome.Icon="&#xE72C;"
                            ToolTip="Check sign-in again" Command="{Binding RefreshCommand}" />
                    <TextBlock x:Name="AccountIcon" DockPanel.Dock="Left" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"
                               Text="&#xE77B;" Foreground="{DynamicResource ChatMutedForeground}" />
                    <TextBlock VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" Text="{Binding AccountText}" />
                </DockPanel>
            </Border>

            <!-- Settings -->
            <Border Style="{StaticResource Panel}" DataContext="{Binding Account}"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="Repository folder (Claude can read and edit files here)" />
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ui:ButtonChrome.Icon="&#xE8A7;"
                                ToolTip="Open the folder in Explorer" Command="{Binding OpenRepositoryCommand}" />
                        <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource ChatButton}" Margin="6,0,0,0"
                                ui:ButtonChrome.Icon="&#xE838;" Command="{Binding BrowseRepositoryCommand}" />
                        <TextBox Style="{StaticResource InputBox}" Padding="5,4"
                                 Text="{Binding RepositoryFolder, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock Margin="0,10,0,0" Style="{StaticResource SectionLabel}" Text="Claude permissions for files and commands" />
                    <StackPanel Margin="0,3,0,0">
                        <StackPanel.Resources>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource ThemedRadio}">
                                <Setter Property="GroupName" Value="ClaudePermissions" />
                            </Style>
                        </StackPanel.Resources>
                        <RadioButton Content="Edit files in the repository folder (recommended)" IsChecked="{Binding PermissionAcceptEdits}" />
                        <RadioButton Content="Auto mode - Claude Code's safety checks approve actions, including commands" IsChecked="{Binding PermissionAuto}" />
                        <RadioButton Content="Read-only - file edits and commands are refused" IsChecked="{Binding PermissionManual}" />
                    </StackPanel>

                    <TextBlock Margin="0,10,0,0" Style="{StaticResource SectionLabel}" Text="Let Claude run SQL that changes the database" />
                    <StackPanel Margin="0,3,0,0">
                        <StackPanel.Resources>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource ThemedRadio}">
                                <Setter Property="GroupName" Value="DatabaseChanges" />
                            </Style>
                        </StackPanel.Resources>
                        <RadioButton Content="Off - read-only queries only" IsChecked="{Binding DatabaseChangesOff}" />
                        <RadioButton Content="Ask me before each change (shows the SQL)" IsChecked="{Binding DatabaseChangesAsk}" />
                        <RadioButton Content="Allow without asking" IsChecked="{Binding DatabaseChangesAllow}" />
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="Model (pick or type a model id)" />
                            <ComboBox Margin="0,4,0,0" IsEditable="True" ItemsSource="{Binding ModelOptions}"
                                      ItemTemplate="{StaticResource OptionalValueTemplate}"
                                      Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="Effort" />
                            <ComboBox Margin="0,4,0,0" ItemsSource="{Binding EffortOptions}"
                                      ItemTemplate="{StaticResource OptionalValueTemplate}"
                                      SelectedItem="{Binding Effort}"
                                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,4,0,0" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ChatMutedForeground}"
                               Text="Empty = Claude Code's default. Higher effort thinks longer; available levels depend on the model." />

                    <TextBlock Margin="0,10,0,0" Style="{StaticResource SectionLabel}" TextWrapping="Wrap"
                               Text="Connection string override (optional; empty = use the active query window's connection)" />
                    <TextBox Margin="0,4,0,0" Style="{StaticResource InputBox}" Padding="5,4"
                             Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,10,0,0" Style="{StaticResource SectionLabel}" Text="Claude Code CLI path (optional; empty = find automatically)" />
                    <TextBox Margin="0,4,0,0" Style="{StaticResource InputBox}" Padding="5,4"
                             Text="{Binding ClaudePath, UpdateSourceTrigger=PropertyChanged}" />

                    <DockPanel Margin="0,10,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource PrimaryButton}" Padding="12,4"
                                ui:ButtonChrome.Icon="&#xE74E;" Command="{Binding SaveSettingsCommand}" />
                        <TextBlock VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ChatMutedForeground}" Text="{Binding SettingsStatus}" />
                    </DockPanel>

                    <!-- About: documentation, website, sponsor -->
                    <Border Margin="0,12,0,0" Height="1" Background="{DynamicResource ChatBorder}" />
                    <WrapPanel Margin="0,8,0,0"
                               DataContext="{Binding DataContext.Appearance, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Button Content="Documentation" Style="{StaticResource LinkButton}" ui:ButtonChrome.Icon="&#xE82D;"
                                Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static ui:ProjectLinks.Documentation}" />
                        <Button Content="Website" Style="{StaticResource LinkButton}" ui:ButtonChrome.Icon="&#xE774;"
                                Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static ui:ProjectLinks.Website}" />
                        <Button Content="Report an issue" Style="{StaticResource LinkButton}" ui:ButtonChrome.Icon="&#xEBE8;"
                                Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static ui:ProjectLinks.Issues}" />
                        <Button Content="Sponsor" Style="{StaticResource LinkButton}" ui:ButtonChrome.Icon="&#xEB52;"
                                Foreground="{DynamicResource ChatSponsor}"
                                Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static ui:ProjectLinks.Sponsor}" />
                    </WrapPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Messages -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource MessageTemplate}" Focusable="False" />
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Style="{StaticResource BrandMark}" FontSize="36" HorizontalAlignment="Center" />
                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"
                           TextWrapping="Wrap" Text="Ask Claude about your database" />
                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource ChatMutedForeground}"
                           Text="Queries, stored procedures, schema design and performance.&#13;&#10;Enter sends, Shift+Enter adds a new line.&#13;&#10;Attach files or screenshots, or paste an image with Ctrl+V." />
            </StackPanel>
        </Grid>

        <!-- Status line -->
        <TextBlock Grid.Row="2" Margin="2,6,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource ChatMutedForeground}" Text="{Binding StatusText}" />

        <!-- Composer: attachments, message box and its toolbar in one rounded box -->
        <Border Grid.Row="3" Margin="0,6,0,0" Padding="8,6" CornerRadius="10" BorderThickness="1"
                AllowDrop="True" PreviewDragOver="Input_PreviewDragOver" PreviewDrop="Input_PreviewDrop">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource ChatInputBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ChatBorder}" />
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource ChatAccent}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Attachments waiting to be sent -->
                <ItemsControl Grid.Row="0" ItemsSource="{Binding PendingAttachments}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,6,6" Padding="8,2,2,2" CornerRadius="6" BorderThickness="1" ToolTip="{Binding Path}"
                                    Background="{DynamicResource ChatSurface}" BorderBrush="{DynamicResource ChatBorder}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,6,0" Text="&#xE723;"
                                               Foreground="{DynamicResource ChatAccent}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="11" MaxWidth="200" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text="{Binding DisplaySize, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource ChatMutedForeground}" />
                                    </TextBlock>
                                    <Button Style="{StaticResource DangerIconButton}" Width="20" Height="20" Margin="4,0,0,0"
                                            ui:ButtonChrome.Icon="&#xE711;" ToolTip="Remove"
                                            Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBox x:Name="InputBox" Grid.Row="1" Style="{StaticResource ComposerText}" Padding="2"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="140"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="InputBox_PreviewKeyDown" />

                <DockPanel Grid.Row="2" Margin="0,4,0,0" LastChildFill="True">
                    <!-- Send while idle, Stop while Claude is replying -->
                    <Grid DockPanel.Dock="Right">
                        <Button Style="{StaticResource PrimaryButton}" Padding="0" Width="32" Height="30"
                                ui:ButtonChrome.Icon="&#xE724;" ToolTip="Send (Enter)" Command="{Binding SendCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Button Style="{StaticResource ChatButton}" Margin="0" Padding="0" Width="32" Height="30"
                                HorizontalContentAlignment="Center" ui:ButtonChrome.Icon="&#xE71A;" ToolTip="Stop"
                                Command="{Binding StopCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Margin="0" ui:ButtonChrome.Icon="&#xE723;"
                            Command="{Binding AttachFileCommand}"
                            ToolTip="Attach files: SQL scripts, execution plans, logs, CSV, images, PDF... (you can also drop files here)" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" ui:ButtonChrome.Icon="&#xF7ED;"
                            Command="{Binding ScreenshotCommand}"
                            ToolTip="Screenshot: select an area of the screen to attach (or press Win+Shift+S, then Ctrl+V in the message box)" />
                    <CheckBox Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource ChipToggle}"
                              Content="Query context" ui:ButtonChrome.Icon="&#xE943;" IsChecked="{Binding IncludeEditorContext}"
                              ToolTip="Include the selected text (or the whole query) of the active query window with your message" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
