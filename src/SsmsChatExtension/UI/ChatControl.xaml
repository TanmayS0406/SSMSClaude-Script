<UserControl x:Class="SsmsChatExtension.UI.ChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             MinWidth="260" MinHeight="200"
             Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Combo box items: an empty value means "use the default". -->
        <DataTemplate x:Key="OptionalValueTemplate">
            <TextBlock x:Name="Value" Text="{Binding}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="">
                    <Setter TargetName="Value" Property="Text" Value="(default)" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Secondary button: subtle tinted background, theme-coloured text ===== -->
        <Style x:Key="ChatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Tint" CornerRadius="3" Opacity="0.08"
                                    Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            <Border CornerRadius="3" BorderThickness="1"
                                    BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Primary button (Send): inverted colours ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Fill" CornerRadius="3" Opacity="0.9"
                                    Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Input box ===== -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="3" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Read-only, selectable message text ===== -->
        <Style x:Key="MessageText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== One chat bubble ===== -->
        <DataTemplate x:Key="MessageTemplate">
            <Grid x:Name="Root" Margin="0,4,36,4">
                <Border x:Name="Bubble" CornerRadius="6" Opacity="0.08"
                        Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                <StackPanel Margin="10,7,10,8">
                    <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" Opacity="0.65" Margin="0,0,0,3"
                               Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                    <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource MessageText}" />
                    <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                        <Button Content="Insert into query window" Style="{StaticResource ChatButton}"
                                Command="{Binding DataContext.InsertCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Copy" Style="{StaticResource ChatButton}"
                                Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="Root" Property="Margin" Value="36,4,0,4" />
                    <Setter TargetName="Bubble" Property="Opacity" Value="0.16" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <DockPanel LastChildFill="True">
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="New chat" Style="{StaticResource ChatButton}" Command="{Binding ClearCommand}"
                            ToolTip="Start a new conversation (the current one stays in History)" />
                    <Button Content="History" Style="{StaticResource ChatButton}" Command="{Binding ToggleHistoryCommand}" />
                    <Button Content="DB diagram" Style="{StaticResource ChatButton}" Command="{Binding DatabaseDiagramCommand}"
                            ToolTip="ER diagram of the active query window's database, opened in your browser" />
                    <Button Content="Settings" Style="{StaticResource ChatButton}" Margin="0"
                            Command="{Binding Account.ToggleSettingsCommand}" />
                </WrapPanel>
                <TextBlock VerticalAlignment="Center" Opacity="0.7" FontSize="11" TextTrimming="CharacterEllipsis"
                           Text="{Binding ServiceName}" ToolTip="{Binding ServiceName}" />
            </DockPanel>

            <!-- Chat history -->
            <Border Margin="0,6,0,0" Padding="6" CornerRadius="3" BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}"
                    Visibility="{Binding IsHistoryOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2" LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="Delete" Style="{StaticResource ChatButton}" Margin="6,0,0,0" Padding="6,2"
                                                Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource ChatButton}" Margin="0" Padding="6,3" HorizontalContentAlignment="Left"
                                                Command="{Binding DataContext.OpenConversationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" ToolTip="Open this chat">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DisplayDate}" FontSize="10" Opacity="0.6" />
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Margin="4" FontSize="11" Opacity="0.6" Text="No saved chats yet.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding History.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Claude account -->
            <Grid Margin="0,6,0,0" DataContext="{Binding Account}">
                <Border CornerRadius="3" Opacity="0.06"
                        Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                <DockPanel Margin="8,5" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Sign in with Claude" Margin="6,0,0,0"
                            Command="{Binding SignInCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Padding" Value="10,4" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button DockPanel.Dock="Right" Content="Sign out" Margin="6,0,0,0" Command="{Binding SignOutCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ChatButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource ChatButton}" Margin="6,0,0,0"
                            Command="{Binding RefreshCommand}" />
                    <TextBlock VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" Text="{Binding AccountText}" />
                </DockPanel>
            </Grid>

            <!-- Settings -->
            <Border Margin="0,6,0,0" Padding="8" CornerRadius="3" BorderThickness="1"
                    DataContext="{Binding Account}"
                    BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock FontSize="11" Opacity="0.75" Text="Repository folder (Claude can read and edit files here)" />
                    <DockPanel Margin="0,3,0,0">
                        <Button DockPanel.Dock="Right" Content="Open" Style="{StaticResource ChatButton}" Margin="6,0,0,0"
                                Command="{Binding OpenRepositoryCommand}" />
                        <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource ChatButton}" Margin="6,0,0,0"
                                Command="{Binding BrowseRepositoryCommand}" />
                        <TextBox Style="{StaticResource InputBox}" Padding="4"
                                 Text="{Binding RepositoryFolder, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <TextBlock Margin="0,8,0,0" FontSize="11" Opacity="0.75" Text="Claude permissions for files and commands" />
                    <StackPanel Margin="0,3,0,0">
                        <StackPanel.Resources>
                            <Style TargetType="RadioButton">
                                <Setter Property="Margin" Value="0,2,0,0" />
                                <Setter Property="GroupName" Value="ClaudePermissions" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            </Style>
                        </StackPanel.Resources>
                        <RadioButton Content="Edit files in the repository folder (recommended)" IsChecked="{Binding PermissionAcceptEdits}" />
                        <RadioButton Content="Auto mode - Claude Code's safety checks approve actions, including commands" IsChecked="{Binding PermissionAuto}" />
                        <RadioButton Content="Read-only - file edits and commands are refused" IsChecked="{Binding PermissionManual}" />
                    </StackPanel>

                    <TextBlock Margin="0,8,0,0" FontSize="11" Opacity="0.75" Text="Let Claude run SQL that changes the database" />
                    <StackPanel Margin="0,3,0,0">
                        <StackPanel.Resources>
                            <Style TargetType="RadioButton">
                                <Setter Property="Margin" Value="0,2,0,0" />
                                <Setter Property="GroupName" Value="DatabaseChanges" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            </Style>
                        </StackPanel.Resources>
                        <RadioButton Content="Off - read-only queries only" IsChecked="{Binding DatabaseChangesOff}" />
                        <RadioButton Content="Ask me before each change (shows the SQL)" IsChecked="{Binding DatabaseChangesAsk}" />
                        <RadioButton Content="Allow without asking" IsChecked="{Binding DatabaseChangesAllow}" />
                    </StackPanel>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="11" Opacity="0.75" Text="Model (pick or type a model id)" />
                            <ComboBox Margin="0,3,0,0" IsEditable="True" ItemsSource="{Binding ModelOptions}"
                                      ItemTemplate="{StaticResource OptionalValueTemplate}"
                                      Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock FontSize="11" Opacity="0.75" Text="Effort" />
                            <ComboBox Margin="0,3,0,0" ItemsSource="{Binding EffortOptions}"
                                      ItemTemplate="{StaticResource OptionalValueTemplate}"
                                      SelectedItem="{Binding Effort}"
                                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,3,0,0" FontSize="10" Opacity="0.6" TextWrapping="Wrap"
                               Text="Empty = Claude Code's default. Higher effort thinks longer; available levels depend on the model." />

                    <TextBlock Margin="0,8,0,0" FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                               Text="Connection string override (optional; empty = use the active query window's connection)" />
                    <TextBox Margin="0,3,0,0" Style="{StaticResource InputBox}" Padding="4"
                             Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,8,0,0" FontSize="11" Opacity="0.75" Text="Claude Code CLI path (optional; empty = find automatically)" />
                    <TextBox Margin="0,3,0,0" Style="{StaticResource InputBox}" Padding="4"
                             Text="{Binding ClaudePath, UpdateSourceTrigger=PropertyChanged}" />

                    <DockPanel Margin="0,8,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource PrimaryButton}" Padding="12,4"
                                Command="{Binding SaveSettingsCommand}" />
                        <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="{Binding SettingsStatus}" />
                    </DockPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Messages -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource MessageTemplate}" Focusable="False" />
            </ScrollViewer>

            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="24" Opacity="0.55" IsHitTestVisible="False"
                       Text="Ask Claude about your database, queries and stored procedures.&#13;&#10;Enter sends, Shift+Enter adds a new line.&#13;&#10;Attach files or screenshots, or paste an image with Ctrl+V.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Status line -->
        <TextBlock Grid.Row="2" Margin="0,6,0,0" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"
                   Text="{Binding StatusText}" />

        <!-- Input -->
        <Grid Grid.Row="3" Margin="0,6,0,0" AllowDrop="True"
              PreviewDragOver="Input_PreviewDragOver" PreviewDrop="Input_PreviewDrop">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Attachments waiting to be sent -->
            <ItemsControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding PendingAttachments}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,6,6" ToolTip="{Binding Path}">
                            <Border CornerRadius="3" Opacity="0.1"
                                    Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            <Border CornerRadius="3" BorderThickness="1"
                                    BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
                            <StackPanel Orientation="Horizontal" Margin="7,2,2,2">
                                <TextBlock VerticalAlignment="Center" FontSize="11" MaxWidth="200" TextTrimming="CharacterEllipsis">
                                    <Run Text="&#x1F4CE;" /> <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text="{Binding DisplaySize, Mode=OneWay}" FontSize="10" />
                                </TextBlock>
                                <Button Content="&#x2715;" Style="{StaticResource ChatButton}" Margin="6,0,0,0" Padding="5,0"
                                        FontSize="10" ToolTip="Remove"
                                        Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox x:Name="InputBox" Grid.Row="1" Grid.Column="0" Style="{StaticResource InputBox}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" MaxHeight="140"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="InputBox_PreviewKeyDown" />

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch">
                <Button Content="Send" Style="{StaticResource PrimaryButton}" Command="{Binding SendCommand}" />
                <Button Content="Stop" Style="{StaticResource ChatButton}" Margin="0,6,0,0" Command="{Binding StopCommand}" />
            </StackPanel>

            <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Screenshot" Style="{StaticResource ChatButton}" Margin="0" Padding="8,2"
                        Command="{Binding ScreenshotCommand}"
                        ToolTip="Select an area of the screen to attach (or press Win+Shift+S, then Ctrl+V in the message box)" />
                <Button DockPanel.Dock="Right" Content="Attach..." Style="{StaticResource ChatButton}" Padding="8,2"
                        Command="{Binding AttachFileCommand}"
                        ToolTip="Attach files: SQL scripts, execution plans, logs, CSV, images, PDF... (you can also drop files here)" />
                <CheckBox VerticalAlignment="Center"
                          Content="Include selected / current query as context"
                          IsChecked="{Binding IncludeEditorContext}"
                          Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
