<platform:DialogWindow x:Class="SsmsChatExtension.UI.DiagramDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                       xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                       xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
                       Title="Database diagram"
                       Width="440" Height="520" MinWidth="360" MinHeight="380"
                       WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
                       Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                       Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}">
    <platform:DialogWindow.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </platform:DialogWindow.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontWeight="SemiBold" Text="{Binding ServerName, StringFormat=Server: {0}}" TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="0,4,0,6" Opacity="0.75" TextWrapping="Wrap"
                       Text="Pick the databases to draw. Relationships are shown within and across the selected databases." />
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="None" MinWidth="0" Click="SelectNone_Click" />
                <Button DockPanel.Dock="Right" Content="All" MinWidth="0" Click="SelectAll_Click" />
                <TextBox x:Name="FilterBox" Padding="3" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter the list" Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" />
            </DockPanel>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,6,0,0" BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,2">
                <ItemsControl ItemsSource="{Binding VisibleDatabases}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}">
                                <TextBlock>
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text="{Binding CurrentMarker, Mode=OneWay}" Foreground="Gray" />
                                </TextBlock>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <CheckBox IsChecked="{Binding InferRelationships}"
                      Content="Infer relationships from column names and types (dashed lines, also across databases)" />
            <CheckBox IsChecked="{Binding IncludeCodeReferences}"
                      Content="List views and procedures that read other databases" />
            <DockPanel Margin="0,8,0,0" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Text="Schema (optional):" />
                <TextBox Padding="3" Text="{Binding Schema, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Only tables in this schema, for example dbo"
                         Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" />
            </DockPanel>
        </StackPanel>

        <TextBlock Grid.Row="3" Margin="0,8,0,0" Opacity="0.75" TextWrapping="Wrap" Text="{Binding SelectionSummary}" />

        <StackPanel Grid.Row="4" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Create diagram" IsDefault="True" Click="Ok_Click" IsEnabled="{Binding HasSelection}" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
    </Grid>
</platform:DialogWindow>
