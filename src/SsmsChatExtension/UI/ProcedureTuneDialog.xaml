<platform:DialogWindow x:Class="SsmsChatExtension.UI.ProcedureTuneDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                       xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                       xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
                       Title="Tune stored procedures"
                       Width="560" Height="620" MinWidth="440" MinHeight="460"
                       WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
                       Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                       Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}">
    <platform:DialogWindow.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <!-- Plain rows: the check box is the selection, so the list box's own highlight would only confuse. -->
        <Style x:Key="PlainRow" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </platform:DialogWindow.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                <Run Text="Database: " /><Run Text="{Binding DatabaseName, Mode=OneWay}" /><Run Text="  on  " /><Run Text="{Binding ServerName, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Margin="0,4,0,6" Opacity="0.75" TextWrapping="Wrap"
                       Text="Tick the procedures to speed up. Claude reads each one, writes an optimized copy next to it (the original is never changed) and opens a before / after benchmark in a new query window." />
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="None" MinWidth="0" Click="SelectNone_Click" />
                <Button DockPanel.Dock="Right" Content="Slowest 5" MinWidth="0" Click="SelectSlowest_Click" IsEnabled="{Binding HasStatistics}"
                        ToolTip="Select the five procedures with the most total execution time since their plans were cached" />
                <Button DockPanel.Dock="Right" Content="All shown" MinWidth="0" Click="SelectAll_Click"
                        ToolTip="Select the procedures that match the filter (up to the limit per run)" />
                <TextBox x:Name="FilterBox" Padding="3" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter the list" Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" />
            </DockPanel>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,6,0,0" BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}">
            <!-- A list box (not an items control in a scroll viewer) so only the visible rows are created: databases can have thousands of procedures. -->
            <ListBox ItemsSource="{Binding View}" ItemContainerStyle="{StaticResource PlainRow}" BorderThickness="0" Background="Transparent"
                     Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="6,2"
                     VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" HorizontalContentAlignment="Stretch"
                                  ToolTip="{Binding ToolTip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Margin="12,0,6,0" Opacity="0.65" Text="{Binding StatsText}" />
                            </Grid>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Text="Timed runs per procedure:" />
                <ComboBox DockPanel.Dock="Left" Width="70" ItemsSource="{Binding RunChoices}" SelectedItem="{Binding Runs}"
                          ToolTip="More runs give a tighter confidence interval; use 50 or more for procedures that finish in under a millisecond"
                          Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}" />
            </DockPanel>
            <CheckBox IsChecked="{Binding RollbackEachRun}" Margin="0,8,0,0"
                      Content="Roll back every run in a transaction (keeps procedures that change data from changing it)" />
        </StackPanel>

        <TextBlock Grid.Row="3" Margin="0,8,0,0" Opacity="0.85" TextWrapping="Wrap" Text="{Binding SelectionSummary}" />

        <StackPanel Grid.Row="4" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Tune and benchmark" IsDefault="True" Click="Ok_Click" IsEnabled="{Binding CanTune}" MinWidth="130" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
    </Grid>
</platform:DialogWindow>
